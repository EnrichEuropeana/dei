#!/usr/bin/env groovy

pipeline {
    agent { label 'DL-Team' }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['test', 'prod'],
            description: 'Deployment target environment (test: staging namespace, prod: production namespace)'
        )
        booleanParam(
            name: 'BUILD_IMAGE',
            defaultValue: true,
            description: 'Whether to build and push container image to the registry before deploying'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Image tag to build and/or deploy (e.g. 1.0.0 or build-42). If empty during build, defaults to "build-${BUILD_NUMBER}". Same tag can be deployed to test and prod.'
        )
        string(
            name: 'IMAGE_REGISTRY',
            defaultValue: 'registry.example.com/enrich-europeana',
            description: 'Container registry host and organization/project path'
        )
        string(
            name: 'IMAGE_NAME',
            defaultValue: 'dei',
            description: 'Container image repository name'
        )
        string(
            name: 'REGISTRY_CREDENTIALS_ID',
            defaultValue: 'harbor-creds',
            description: 'Jenkins credentials ID (Username with password) for Container Registry'
        )
        string(
            name: 'OKD_CREDENTIALS_ID',
            defaultValue: '',
            description: 'Optional override for Jenkins credentials ID (Secret text) for OKD / OpenShift API token (defaults to okd-token for test, okd-token-production for prod)'
        )
        string(
            name: 'OKD_SERVER',
            defaultValue: '',
            description: 'Optional override for OKD API Server URL (leave empty to resolve from env-*-private.params in private GitLab repository)'
        )
        booleanParam(
            name: 'USE_PRIVATE_CONFIG',
            defaultValue: true,
            description: 'Whether to fetch and apply private environment parameters from the private GitLab configuration repository'
        )
        string(
            name: 'CONFIG_REPO_CREDS_ID',
            defaultValue: 'gitlab-config-repo-ssh-key',
            description: 'Jenkins credentials ID (SSH Username with private key) for GitLab configuration repository'
        )
        string(
            name: 'CONFIG_REPO_URL_CREDS_ID',
            defaultValue: 'gitlab-config-repo-url',
            description: 'Jenkins credentials ID (Secret text) containing private GitLab repository SSH URL'
        )
    }

    environment {
        TEMPLATE_FILE = 'okd/template.yaml'
        PRIVATE_CONFIG_DIR = '.private-config'
        M2_HOME = "${tool 'maven-3.5.0'}".trim()
        JAVA_HOME = "${tool 'openjdk-11-dlteam'}".trim()
        PATH = "${env.M2_HOME}/bin:${env.JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Initialize Environment') {
            steps {
                script {
                    // Environment-specific configuration defaults
                    def envConfigs = [
                        'test': [
                            defaultNamespace: 'dei-staging',
                            defaultServer: 'https://api.okd.example.com:6443/',
                            credentialsId: params.OKD_CREDENTIALS_ID?.trim() ?: 'okd-token',
                            paramFile: 'okd/env-test.params',
                            privateParamFile: 'env-test-private.params',
                            appName: 'dei-staging'
                        ],
                        'prod': [
                            defaultNamespace: 'dei-production',
                            defaultServer: 'https://api.okd.example.com:6443/',
                            credentialsId: params.OKD_CREDENTIALS_ID?.trim() ?: 'okd-token-production',
                            paramFile: 'okd/env-prod.params',
                            privateParamFile: 'env-prod-private.params',
                            appName: 'dei-production'
                        ]
                    ]

                    def targetEnv = params.ENVIRONMENT ?: 'test'
                    def config = envConfigs[targetEnv] ?: envConfigs['test']

                    env.TARGET_ENV = targetEnv
                    env.TARGET_OKD_CREDS = config.credentialsId
                    env.PARAM_FILE = config.paramFile
                    env.PRIVATE_PARAM_FILE = config.privateParamFile
                    env.APP_NAME = config.appName
                    env.CONFIG_REPO_CREDS = params.CONFIG_REPO_CREDS_ID?.trim() ?: 'gitlab-config-repo-ssh-key'
                    env.CONFIG_REPO_URL_CREDS = params.CONFIG_REPO_URL_CREDS_ID?.trim() ?: 'gitlab-config-repo-url'

                    // Initial target server and namespace defaults
                    env.TARGET_SERVER = params.OKD_SERVER?.trim() ?: config.defaultServer
                    env.TARGET_NAMESPACE = config.defaultNamespace

                    // Tag is environment-neutral (e.g. build-123 or explicit tag), allowing identical image promoting to prod
                    def tag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : "build-${env.BUILD_NUMBER}"
                    env.DEPLOY_TAG = tag
                    env.FULL_IMAGE = "${params.IMAGE_REGISTRY}/${params.IMAGE_NAME}:${env.DEPLOY_TAG}"

                    echo "================ DEPLOYMENT CONFIGURATION ================"
                    echo "Target Environment     : ${env.TARGET_ENV}"
                    echo "Application Name       : ${env.APP_NAME}"
                    echo "OKD Cluster Server     : ${env.TARGET_SERVER}"
                    echo "OKD Namespace          : ${env.TARGET_NAMESPACE}"
                    echo "OKD Token Creds ID     : ${env.TARGET_OKD_CREDS}"
                    echo "Container Image        : ${env.FULL_IMAGE}"
                    echo "Build Image Stage      : ${params.BUILD_IMAGE}"
                    echo "Public Param File      : ${env.PARAM_FILE}"
                    echo "Private Param File     : ${env.PRIVATE_PARAM_FILE}"
                    echo "Use Private Config     : ${params.USE_PRIVATE_CONFIG}"
                    echo "Config SSH Creds ID    : ${env.CONFIG_REPO_CREDS}"
                    echo "Config Repo URL Creds  : ${env.CONFIG_REPO_URL_CREDS}"
                    echo "=========================================================="
                }
            }
        }

        stage('Fetch Private Configuration') {
            when {
                expression { return params.USE_PRIVATE_CONFIG == true }
            }
            steps {
                script {
                    echo "Fetching private deployment configuration from GitLab repository via Git SCM..."
                    dir("${env.PRIVATE_CONFIG_DIR}") {
                        deleteDir()
                    }

                    withCredentials([
                        string(credentialsId: env.CONFIG_REPO_URL_CREDS, variable: 'CONFIG_REPO_URL')
                    ]) {
                        dir("${env.PRIVATE_CONFIG_DIR}") {
                            // Use Jenkins native Git plugin step with SSH Deploy Key
                            git credentialsId: env.CONFIG_REPO_CREDS,
                                url: env.CONFIG_REPO_URL,
                                branch: 'main'
                        }
                    }

                    // Extract OKD_SERVER and OKD_NAMESPACE from private params file if not explicitly overridden via build parameters
                    def privateParamPath = "${env.PRIVATE_CONFIG_DIR}/${env.PRIVATE_PARAM_FILE}"
                    if (fileExists(privateParamPath)) {
                        echo "Extracting infrastructure parameters from private config: ${privateParamPath}"

                        if (!params.OKD_SERVER?.trim()) {
                            def extractedServer = sh(
                                script: "grep -E '^[[:space:]]*OKD_SERVER=' ${privateParamPath} | cut -d'=' -f2- | tr -d '\\r' || true",
                                returnStdout: true
                            ).trim()
                            if (extractedServer) {
                                env.TARGET_SERVER = extractedServer
                                echo "Resolved OKD Server URL from private config: ${env.TARGET_SERVER}"
                            }
                        } else {
                            echo "Using explicit OKD_SERVER parameter override: ${env.TARGET_SERVER}"
                        }

                        def extractedNamespace = sh(
                            script: "grep -E '^[[:space:]]*OKD_NAMESPACE=' ${privateParamPath} | cut -d'=' -f2- | tr -d '\\r' || true",
                            returnStdout: true
                        ).trim()
                        if (extractedNamespace) {
                            env.TARGET_NAMESPACE = extractedNamespace
                            echo "Resolved OKD Namespace from private config: ${env.TARGET_NAMESPACE}"
                        }
                    }
                }
            }
        }

        stage('Build & Test (Maven)') {
            when {
                expression { return params.BUILD_IMAGE == true }
            }
            steps {
                script {
                    echo "Building project with Maven for environment: ${env.TARGET_ENV}"
                    sh "mvn -Dmaven.test.failure.ignore=true install -P ${env.TARGET_ENV}"
                }
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/**/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Build & Push Container Image') {
            when {
                expression { return params.BUILD_IMAGE == true }
            }
            steps {
                script {
                    echo "Building and pushing container image: ${env.FULL_IMAGE}"
                    def registryHost = params.IMAGE_REGISTRY.split('/')[0]
                    def credsId = params.REGISTRY_CREDENTIALS_ID?.trim() ? params.REGISTRY_CREDENTIALS_ID.trim() : 'container-registry-creds'

                    withCredentials([usernamePassword(credentialsId: credsId, usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
                        try {
                            echo "Authenticating to container registry: ${registryHost}"
                            sh """
                                echo "\${REGISTRY_PASSWORD}" | docker login "${registryHost}" -u "\${REGISTRY_USER}" --password-stdin
                            """
                            sh "docker build -t ${env.FULL_IMAGE} ."
                            sh "docker push ${env.FULL_IMAGE}"
                        } finally {
                            sh "docker logout ${registryHost} || true"
                        }
                    }
                }
            }
        }

        stage('Login & Deploy to OKD') {
            steps {
                script {
                    echo "Authenticating to OKD cluster: ${env.TARGET_SERVER} with token credentials ID: ${env.TARGET_OKD_CREDS}"

                    withCredentials([string(credentialsId: env.TARGET_OKD_CREDS, variable: 'OKD_TOKEN')]) {
                        sh """
                            oc login --token="\${OKD_TOKEN}" \
                                     --server="${env.TARGET_SERVER}" \
                                     --insecure-skip-tls-verify=true
                        """
                    }

                    // Switch to target namespace
                    sh "oc project ${env.TARGET_NAMESPACE}"

                    echo "Processing OpenShift template: ${env.TEMPLATE_FILE}"
                    echo "Deploying container image: ${env.FULL_IMAGE}"

                    // Construct template parameters to override
                    def templateParams = [
                        "-p APP_NAME=${env.APP_NAME}",
                        "-p ENVIRONMENT=${env.TARGET_ENV}",
                        "-p IMAGE_REGISTRY=${params.IMAGE_REGISTRY}",
                        "-p IMAGE_NAME=${params.IMAGE_NAME}",
                        "-p IMAGE_TAG=${env.DEPLOY_TAG}"
                    ]

                    def paramsString = templateParams.join(' ')
                    def baseParamArg = fileExists(env.PARAM_FILE) ? "--param-file=${env.PARAM_FILE}" : ""

                    // Check for private environment parameter overrides from GitLab
                    def privateParamPath = "${env.PRIVATE_CONFIG_DIR}/${env.PRIVATE_PARAM_FILE}"
                    def privateParamArg = ""
                    if (params.USE_PRIVATE_CONFIG && fileExists(privateParamPath)) {
                        echo "Applying private configuration overrides from: ${privateParamPath}"
                        privateParamArg = "--param-file=${privateParamPath}"
                    } else if (params.USE_PRIVATE_CONFIG) {
                        echo "Notice: Private param file '${env.PRIVATE_PARAM_FILE}' not found in '${env.PRIVATE_CONFIG_DIR}'. Proceeding with base parameter file."
                    }

                    // Process template with public and private param files (private params override base params), then apply
                    sh """
                        oc process -f ${env.TEMPLATE_FILE} ${baseParamArg} ${privateParamArg} ${paramsString} -n ${env.TARGET_NAMESPACE} | oc apply -f - -n ${env.TARGET_NAMESPACE}
                    """
                }
            }
        }

        stage('Verify Rollout') {
            steps {
                script {
                    echo "Waiting for deployment rollout to complete: ${env.APP_NAME}"
                    sh "oc rollout status deployment/${env.APP_NAME} --timeout=5m -n ${env.TARGET_NAMESPACE}"

                    // Display exposed route URL
                    sh """
                        echo "Deployment successful! Route details:"
                        oc get route ${env.APP_NAME} -n ${env.TARGET_NAMESPACE} -o jsonpath='{"https://"}{.spec.host}{"\\n"}' || true
                    """
                }
            }
        }
    }

    post {
        always {
            // Securely clean up private configuration files from agent workspace
            dir("${env.PRIVATE_CONFIG_DIR}") {
                deleteDir()
            }
            echo "Pipeline execution finished for build #${env.BUILD_NUMBER}"
        }
        success {
            echo "DEI application successfully deployed to OKD environment: ${env.TARGET_ENV} (${env.TARGET_NAMESPACE}) with image tag: ${env.DEPLOY_TAG}!"
        }
        failure {
            echo "DEI deployment failed. Check logs and OpenShift events."
            sh "oc get events --sort-by='.metadata.creationTimestamp' -n ${env.TARGET_NAMESPACE} | tail -n 20 || true"
        }
    }
}
