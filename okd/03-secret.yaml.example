# Example Secret definition for DEI application.
# IMPORTANT: Do NOT commit production secrets to Git.
# Configure secrets directly in OKD using Web Console or CLI:
#
# oc create secret generic dei-staging-secret \
#   --from-literal=SPRING_DATASOURCE_URL="jdbc:mysql://db.example.com:3306/dei_staging?useLegacyDatetimeCode=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false" \
#   --from-literal=SPRING_DATASOURCE_USERNAME="dei_user" \
#   --from-literal=SPRING_DATASOURCE_PASSWORD="your-db-password" \
#   --from-literal=EUROPEANA_NEW_API_TP_AUTHORIZATION_TOKEN="your-token" \
#   --from-literal=API_CLIENT_ID="transcribathon-dei" \
#   --from-literal=API_CLIENT_SECRET="your-client-secret" \
#   --from-literal=API_USERNAME="your-api-username" \
#   --from-literal=API_PASSWORD="your-api-password" \
#   --from-literal=DRI_API_TOKEN="your-dri-token" \
#   -n dei-staging
#
# # SSH key generation (ed25519):
# ssh-keygen -t ed25519 -C "dei-rsync-key" -f ~/.ssh/id_ed25519
#
# # SSH secret for rsync CronJob (staging)
# oc create secret generic dei-staging-ssh-secret \
#   --from-file=id_ed25519=~/.ssh/id_ed25519 \
#   -n dei-staging
#
# # SSH secret for rsync CronJob (production)
# oc create secret generic dei-production-ssh-secret \
#   --from-file=id_ed25519=~/.ssh/id_ed25519 \
#   -n dei-production
#
apiVersion: v1
kind: Secret
metadata:
  name: dei-secret # Note: matches ${APP_NAME}-secret (e.g. dei-staging-secret or dei-production-secret)
  labels:
    app: dei
type: Opaque
stringData:
  # External MySQL database configuration
  SPRING_DATASOURCE_URL: "jdbc:mysql://db.example.com:3306/dei_db?useLegacyDatetimeCode=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false"
  SPRING_DATASOURCE_USERNAME: "dei_user"
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME"
  
  # Authorization tokens
  EUROPEANA_NEW_API_TP_AUTHORIZATION_TOKEN: "CHANGE_ME"

  # API OAuth credentials
  API_CLIENT_ID: "transcribathon-dei"
  API_CLIENT_SECRET: "CHANGE_ME"
  API_USERNAME: "CHANGE_ME"
  API_PASSWORD: "CHANGE_ME"

  # DRI Enrichment API token
  DRI_API_TOKEN: "CHANGE_ME"
