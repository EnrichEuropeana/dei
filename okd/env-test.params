ENVIRONMENT=test
APP_NAME=dei-staging
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/dei-test
CONVERSION_DIRECTORY=/data/conversion
CONVERSION_IIIF_SERVER_URL=https://iiif-test.man.poznan.pl
TRANSCRIPTION_API_URL=http://fresenia-dev.man.poznan.pl/dev/tp-api
TRANSCRIPTION_NEW_API_URL=https://api.fresenia-dev.man.poznan.pl/v2
TRANSCRIPTION_HAU_NEW_API_URL=https://annotations.fresenia-dev.man.poznan.pl/v2
TRANSCRIPTION_KB_NEW_API_URL=https://transcribathon.fresenia-dev.man.poznan.pl/v2
EUROPEANA_API_ANNOTATIONS_ENDPOINT=https://annotation-api-test.eanadev.org/annotation/
EUROPEANA_API_RECORD_ENDPOINT=https://www.europeana.eu/api/v2/record
KEYCLOAK_REALM=enrich-europeana-dev
KEYCLOAK_RESOURCE=dei-staging-enrich-europeana-dei-staging.apps.bst2.paas.psnc.pl
KEYCLOAK_AUTH_SERVER_URL=https://keycloak-dev.pcss.pl
KEYCLOAK_CONFIDENTIAL_PORT=443
JAVA_OPTS=-Dfile.encoding=UTF-8 -Dhttps.protocols=TLSv1.3,TLSv1.2 -Xms512m -Xmx2048m
STORAGE_SIZE=10Gi
REPLICAS=1
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=3Gi
CPU_REQUEST=500m
CPU_LIMIT=2
