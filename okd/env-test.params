ENVIRONMENT=test
APP_NAME=dei-staging
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/dei-test
CONVERSION_DIRECTORY=/data/conversion
CONVERSION_IIIF_SERVER_URL=https://iiif-test.example.com
TRANSCRIPTION_API_URL=https://transcription-test.example.com/tp-api
TRANSCRIPTION_NEW_API_URL=https://api-test.transcription.example.com/v2
TRANSCRIPTION_HAU_NEW_API_URL=https://annotations-test.transcription.example.com/v2
TRANSCRIPTION_KB_NEW_API_URL=https://transcribathon-test.example.com/v2
EUROPEANA_API_ANNOTATIONS_ENDPOINT=https://annotation-api-test.eanadev.org/annotation/
EUROPEANA_API_RECORD_ENDPOINT=https://www.europeana.eu/api/v2/record
KEYCLOAK_REALM=enrich-europeana-test
KEYCLOAK_RESOURCE=dei-staging
KEYCLOAK_AUTH_SERVER_URL=https://sso-test.example.com/auth
KEYCLOAK_CONFIDENTIAL_PORT=443
JAVA_OPTS=-Dfile.encoding=UTF-8 -Dhttps.protocols=TLSv1.3,TLSv1.2 -Xms512m -Xmx2048m
STORAGE_SIZE=10Gi
STORAGE_CLASS=manila-share
REPLICAS=1
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=3Gi
CPU_REQUEST=500m
CPU_LIMIT=2
RSYNC_SCHEDULE=*/15 * * * *
RSYNC_IMAGE=instrumentisto/rsync-ssh:latest
RSYNC_SSH_SECRET_NAME=dei-staging-ssh-secret
RSYNC_SRC_SUBDIR=out
RSYNC_DEST_HOST=iiif-test.example.com
RSYNC_DEST_USER=dei
RSYNC_DEST_PATH=iiifFiles
RSYNC_DEST_PORT=22
