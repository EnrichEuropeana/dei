ENVIRONMENT=prod
APP_NAME=dei-production
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/dei
CONVERSION_DIRECTORY=/data/conversion
CONVERSION_IIIF_SERVER_URL=https://iiif.example.com
TRANSCRIPTION_API_URL=https://transcription.example.com/tp-api
TRANSCRIPTION_NEW_API_URL=https://api.transcription.example.com/v2
TRANSCRIPTION_HAU_NEW_API_URL=https://annotations.transcription.example.com/v2
TRANSCRIPTION_KB_NEW_API_URL=https://transcribathon.example.com/v2
EUROPEANA_API_ANNOTATIONS_ENDPOINT=https://api.europeana.eu/annotation/
EUROPEANA_API_RECORD_ENDPOINT=https://api.europeana.eu/record/v2
KEYCLOAK_REALM=EnrichEuropeana
KEYCLOAK_RESOURCE=dei-production
KEYCLOAK_AUTH_SERVER_URL=https://sso.example.com/auth
KEYCLOAK_CONFIDENTIAL_PORT=443
JAVA_OPTS=-Dfile.encoding=UTF-8 -Dhttps.protocols=TLSv1.3,TLSv1.2 -Xms512m -Xmx2048m
STORAGE_SIZE=10Gi
STORAGE_CLASS=manila-share
REPLICAS=1
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=3Gi
CPU_REQUEST=500m
CPU_LIMIT=2
RSYNC_SCHEDULE=*/15 * * * *
RSYNC_IMAGE=instrumentisto/rsync-ssh:latest
RSYNC_SSH_SECRET_NAME=dei-production-ssh-secret
RSYNC_SRC_SUBDIR=out
RSYNC_DEST_HOST=iiif.example.com
RSYNC_DEST_USER=dei
RSYNC_DEST_PATH=iiifFiles
RSYNC_DEST_PORT=22
